# Beets Web Manager Backend Environment Configuration

# Application Settings
# APP_NAME=Beets Web Manager
# DEBUG=false

# Database
# DATABASE_URL=postgresql://beets:beets@postgres:5432/beets_db

# Redis
# REDIS_URL=redis://redis:6379/0

# Celery
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
# SECRET_KEY=change-me-in-production

# Basic Authentication (Optional)
# When both BASIC_AUTH_USER and BASIC_AUTH_PASSWORD are set, all endpoints
# will require HTTP Basic Authentication. If either is unset or empty,
# authentication is disabled and all endpoints are publicly accessible.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=your-secure-password

# CORS
# CORS_ORIGINS=*

# Volume Paths
# LIBRARIES_PATH=/data/libraries
# IMPORT_PATH=/data/import
# UPLOAD_PATH=/data/upload
# CONFIG_PATH=/config
# DATABASES_PATH=/data/databases

# Import Folder Watcher Configuration
# ENABLE_IMPORT_WATCHERS=true
# SCAN_DEBOUNCE_SECONDS=30
# SCAN_TIMEOUT_SECONDS=3600
