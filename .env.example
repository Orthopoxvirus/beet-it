# Beets Web Manager Environment Configuration
# Copy this file to .env and fill in your values

# Stack name (used for container naming + docker compose project grouping).
# Default matches the repo name. Append `-dev` (or any suffix) when running a
# side-by-side preview/staging instance on the same host — for example:
#   STACK_NAME=beet-it-dev
STACK_NAME=beet-it

# Image source. Default builds the images locally from ./backend and
# ./frontend (`docker compose up` / `docker compose build`). Point this at a
# registry prefix instead to pull prebuilt images, e.g.:
#   IMAGE_PREFIX=ghcr.io/your-org/beet-it
#IMAGE_PREFIX=beet-it
#IMAGE_TAG=latest

# PostgreSQL Configuration
POSTGRES_USER=beets
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=beets_db

# Application Secret Key (generate a secure random string)
SECRET_KEY=change-me-to-a-secure-random-string

# CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=*

# Debug Mode (set to true for development)
DEBUG=false

# Import Folder Watcher Configuration
# Enable automatic filesystem monitoring for import folders
ENABLE_IMPORT_WATCHERS=true
# Debounce time in seconds (wait for file activity to settle before scanning)
SCAN_DEBOUNCE_SECONDS=30
# Maximum scan duration in seconds (default 1 hour)
SCAN_TIMEOUT_SECONDS=3600
