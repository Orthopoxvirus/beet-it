# Environment files
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
/downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# Unignore frontend source directories named lib/ — the Python venv `lib/`
# rule above would otherwise silently hide frontend/src/lib/utils.ts and
# break `npm run build` for fresh clones.
!frontend/src/lib/
!frontend/src/lib/**

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
frontend/dist/
backend/build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data directories
data/

# Per-library beets configs (user-specific; never commit).
# The example template stays tracked so new clones have a reference.
config/*
!config/.gitkeep
!config/example.yaml

# Docker
*.log
docker-compose.override.yaml
docker-compose.override.yml

# Testing
.coverage
htmlcov/
.pytest_cache/
.nyc_output/
coverage/

# Misc
*.bak
*.tmp

# Browser automation captures (Playwright MCP writes here per-session)
.playwright-mcp/

# Harness / agent runtime state
.claude/

# Ad-hoc screenshots from manual debugging — keep docs/ screenshots instead
/*.png
/*.jpg
/*.jpeg

# Bind-mounted SQLite beets DBs (one per library)
/databases/
